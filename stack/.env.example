# IP de esta máquina en la LAN (ajústala a tu red)
LAN_IP=10.0.0.2

TZ=UTC

# Panel Pterodactyl (por IP o por dominio local tras NPM)
APP_URL=http://panel.homelab
APP_SERVICE_AUTHOR=noreply@example.com

# Contraseñas de MariaDB del panel (cambiar antes del primer arranque)
PANEL_DB_PASSWORD=CHANGE_ME
PANEL_DB_ROOT_PASSWORD=CHANGE_ME_TOO

# Sufijo DNS local (AdGuard rewrites + proxy hosts en NPM)
LOCAL_DOMAIN=homelab

# Opcional: scripts npm-homelab-ssl.sh / configure-local-domains.sh
# NPM_EMAIL=admin@example.com
# NPM_PASSWORD=CHANGE_ME
